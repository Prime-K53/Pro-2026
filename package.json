{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines=80 --functions=80 --branches=70 --statements=80 --include='src/server/**/*.ts' --include='src/services/**/*.ts' --include='src/utils/**/*.ts' node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "perf:smoke": "node --import tsx scripts/perf-smoke.ts",
    "test:inventory": "tsx tests/inventory/inventory-advanced-ops.test.ts",
    "test:db": "tsx tests/db/migration-suite.ts",
    "test:security": "tsx tests/security/auth-isolation.test.ts",
    "test:accounting": "tsx tests/accounting/accounting-foundation.test.ts",
    "test:commercial": "tsx tests/commercial/commercial-financial.test.ts",
    "test:controls": "tsx tests/finance-controls/finance-controls.test.ts",
    "test:printing": "tsx tests/printing/paper-toner-calc.test.ts",
    "test:quick-print": "tsx tests/printing/quick-print-typing-revenue.test.ts",
    "test:quick-print-calc": "tsx tests/printing/quick-print-calc-unit.test.ts",
    "test:wallet": "tsx tests/wallet/customer-wallet.test.ts",
    "test:contracts": "tsx tests/printing/contract-lifecycle.test.ts",
    "test:amendments": "tsx tests/printing/contract-amendments.test.ts",
    "test:printing-contracts": "tsx tests/printing/contracts-gap-closure.test.ts",
    "test:exam-integrity": "tsx tests/printing/exam-production-integrity.test.ts",
    "test:exam-lifecycle": "tsx tests/printing/exam-lifecycle.test.ts",
    "test:exam-isolation": "tsx tests/printing/exam-tenant-isolation.test.ts",
    "test:workflows": "tsx tests/workflows/phase9-e2e-workflows.test.ts",
    "test:migration": "tsx tests/migration/slowbooks-migration.test.ts",
    "test:documents": "tsx tests/documents/documents-and-invoicing.test.ts",
    "migrate:slowbooks": "tsx scripts/migrate-slowbooks.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jose": "^6.2.17",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
