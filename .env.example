# ─── AI ───────────────────────────────────────────────────────────────────────
# Per-company AI provider keys are configured in-app (AI settings) and stored
# encrypted. GEMINI_API_KEY is only a legacy/optional convenience.
GEMINI_API_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
# Comma-separated extra origins allowed by CORS in production (optional).
CORS_ALLOWED_ORIGINS=""
# Set to true only when running behind a trusted reverse proxy (so X-Forwarded-For is honored).
TRUST_PROXY="false"

# ─── Supabase Auth ────────────────────────────────────────────────────────────
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# ─── Secrets (REQUIRED in production — startup fails without them) ─────────────
# Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=""
# Encryption key for secrets at rest (AI keys, TOTP). openssl rand -hex 32
TOTP_ENC_KEY=""
AUTH_SESSION_TTL_SECONDS="28800"
AUTH_IDLE_TIMEOUT_SECONDS="7200"

# ─── Local Server & Embedded PGlite Storage ───────────────────────────────────
PORT="3000"
PMS_PG_DATA_DIR=".data/pms-pg"
PMS_ATTACHMENTS_DIR=".data/attachments"

# ─── Document QR ──────────────────────────────────────────────────────────────
# HMAC key for document verification QR tokens (optional; falls back to session secret).
QR_TOKEN_KEY=""

# ─── Twilio (optional, for SMS/WhatsApp) ──────────────────────────────────────
TWILIO_AUTH_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_FROM_NUMBER=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_WHATSAPP_FROM=""

# ─── SMTP (optional, scheduled report delivery) ───────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""